# Signal — environment variables. Names and comments only, never values.
# Copy to .env.local for development. Set all of these in Vercel project settings for production.

# --- Database -----------------------------------------------------------------
# Neon Postgres connection string. REQUIRED IN PRODUCTION.
# If unset, the app boots an in-memory PGlite database instead: fine for local dev
# and tests, fatal on Vercel because serverless state resets per invocation.
# /health shows a red banner whenever the in-memory driver is active.
DATABASE_URL=

# --- AI -----------------------------------------------------------------------
# Google AI Studio key for the pinned Gemini Flash model. If unset the app still
# starts and runs in rules-only mode with an orange banner on screen.
GEMINI_API_KEY=
# OpenRouter key. Transport fallback only; the model stays pinned to Gemini Flash.
OPENROUTER_API_KEY=
# Per-run spend cap in USD. The run stops cleanly at the ceiling and keeps every
# company already completed. Defaults to 1.00 when unset.
AI_COST_CEILING_USD=

# --- Point of contact ---------------------------------------------------------
# Hunter.io key, used for Domain Search and the live quota meter on /health.
# If unset, contacts fall back to the seeded set and render a visible `seeded` badge.
HUNTER_API_KEY=

# --- Send ---------------------------------------------------------------------
# Gmail API OAuth2. Scope required: https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# THE HARDCODED RECIPIENT. Read only on the server, never exposed to the client as
# an input. No UI field, no query param and no API body can change it.
# This is the one variable the app refuses to start without.
GMAIL_SEND_TO=

# Resend, the disclosed fallback transport. The UI always names which one sent.
RESEND_API_KEY=
EMAIL_FROM=

# --- Site ---------------------------------------------------------------------
# Production URL used to build absolute links. Must never be localhost in production.
NEXT_PUBLIC_SITE_URL=
